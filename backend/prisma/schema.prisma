generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  walletAddress String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@index([walletAddress])
}

model Payment {
  id               String        @id @default(uuid())
  merchantId       String
  /// bytes32 payment ID generated by PaymentGateway.sol
  paymentId        String        @unique
  /// Amount in the token's smallest unit.
  /// Example: 1 USDC = "1000000"
  amount           String
  /// ERC-20 contract address.
  /// Native currency payments use the zero address.
  tokenAddress     String
  /// Merchant receiving the payment.
  recipientAddress String
  description      String?
  status           PaymentStatus @default(CREATED)
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchant         Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@index([merchantId])
  @@index([status])
  @@index([expiresAt])
  @@index([recipientAddress])
}

model Transaction {
  id               String            @id @default(uuid())
  paymentId        String
  /// Blockchain transaction hash.
  txHash           String
  /// EVM chain ID.
  chainId          BigInt
  senderAddress    String
  recipientAddress String
  tokenAddress     String
  /// Amount in the token's smallest unit.
  amount           String
  blockNumber      BigInt?
  confirmations    Int               @default(0)
  status           TransactionStatus @default(DETECTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payment          Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHash])
  @@index([paymentId])
  @@index([txHash])
  @@index([senderAddress])
  @@index([recipientAddress])
  @@index([status])
}

model Network {
  id                      String   @id @default(uuid())
  name                    String
  chainId                 BigInt   @unique
  rpcUrl                  String
  explorerUrl             String
  nativeToken             String
  /// Number of block confirmations required before
  /// a payment is considered confirmed.
  confirmationRequirement Int
  /// PaymentGateway deployment on this network.
  gatewayAddress          String
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tokens                  Token[]

  @@index([isActive])
}

model Token {
  id              String   @id @default(uuid())
  networkId       String
  name            String
  symbol          String
  /// ERC-20 contract address.
  /// Native currency can use the zero address.
  contractAddress String
  decimals        Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  network         Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, contractAddress])
  @@index([networkId])
  @@index([symbol])
  @@index([isActive])
}

enum PaymentStatus {
  CREATED
  PENDING
  TRANSACTION_DETECTED
  VERIFYING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  DETECTED
  CONFIRMED
  FAILED
}
